{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u6807\u9898"
    },
    "content": {
      "type": "string",
      "title": "\u6b63\u6587"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "\u53d1\u5e03\u65e5\u671f"
    },
    "pinned": {
      "type": "boolean",
      "title": "\u7f6e\u9876",
      "default": false
    },
    "category": {
      "type": "string",
      "title": "\u5206\u7c7b",
      "enum": [
        "notice",
        "news",
        "event"
      ],
      "default": "notice"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
