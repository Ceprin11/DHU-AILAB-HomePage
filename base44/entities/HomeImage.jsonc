{
  "name": "HomeImage",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "图片名称"
    },
    "image_url": {
      "type": "string",
      "format": "file",
      "title": "主页图片"
    },
    "alt_text": {
      "type": "string",
      "title": "图片说明"
    },
    "order_index": {
      "type": "number",
      "title": "轮播顺序",
      "default": 0
    }
  },
  "required": [
    "title",
    "image_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
